# Скопируйте в .env и заполните:  cp .env.example .env

# --- Telegram ---
TELEGRAM_TOKEN=123456:ABC-your-bot-token
# Необязательно: Telegram ID членов семьи через запятую. Пусто = бот отвечает всем.
ALLOWED_USER_IDS=

# --- LLM (любой OpenAI-совместимый API с function calling) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini

# --- Общее ---
# Часовой пояс: от него зависит, что такое «сегодня» и «вчера»
TZ=Europe/Moscow
