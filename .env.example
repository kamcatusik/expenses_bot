# Скопируйте в .env и заполните:  cp .env.example .env

# --- Telegram ---
TELEGRAM_TOKEN=
# Необязательно: Telegram ID членов семьи через запятую. Пусто = бот отвечает всем.
ALLOWED_USER_IDS=

# --- LLM (любой OpenAI-совместимый API с function calling) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Общее ---
# Часовой пояс: от него зависит, что такое «сегодня» и «вчера»
TZ=Europe/Moscow
